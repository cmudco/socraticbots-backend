# Socratic Bots backend — copy to `.env` in the repository root.
# Every variable is documented in docs/reference/configuration.md.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DEBUG=True

# Extra hosts/origins for your own deployment (comma-separated).
# These are added to the built-in localhost entries.
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Leave DB_HOST empty to use SQLite at backend/db.sqlite3.
# Set DB_HOST (and the rest) to use PostgreSQL.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# --- DARE (required) ------------------------------------------------------
# Socratic Bots delegates accounts, chat, files, and billing to DARE.
DARE_BACKEND_URL=http://127.0.0.1:8000
# Must equal SSO_JWT_KEY in DARE's .env. If empty, every request is unauthenticated.
SSO_JWT_KEY=change-me-shared-jwt-key
# Must equal DARE_INTERNAL_KEY in DARE's .env (and in the voice runtime's .env).
DARE_INTERNAL_KEY=local-dev-internal-key
# This backend's own URL; DARE uses it to recognise Socratic Bots traffic.
SOCRATIC_BOTS_BACKEND_URL=http://127.0.0.1:8001

# --- Voice: Mistral / Pipecat runtime (optional) --------------------------
# Leave VOICE_RUNTIME_PUBLIC_URL empty to run without voice agents.
VOICE_RUNTIME_PUBLIC_URL=
VOICE_RUNTIME_SESSION_SECRET=
VOICE_RUNTIME_ICE_SERVERS=stun:stun.l.google.com:19302
VOICE_RUNTIME_STARTUP_CLAIMS_ENABLED=false
# Used to list Mistral voices in the voice-agent editor.
MISTRAL_API_KEY=

# --- Voice: ElevenLabs (optional) -----------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_ID=

# --- Docker Compose only --------------------------------------------------
# `docker compose up` needs DB_PASSWORD above. The containers use the bundled
# Postgres and ignore DB_HOST, DEBUG and DARE_BACKEND_URL; set these instead.
# DOCKER_DARE_BACKEND_URL=http://host.docker.internal:8000
# DOCKER_DEBUG=False
# WEB_PORT=8001
# POSTGRES_PORT=5433
# GUNICORN_WORKERS=3

# --- Sentry (optional; leave SENTRY_DSN empty to disable) -----------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
